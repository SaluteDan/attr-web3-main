# npm ci fails ERESOLVE without this: solidity-coverage@0.8.17 declares a
# peerDependency on hardhat ^2.11.0, but this repo runs hardhat v3.4.5.
# solidity-coverage is used only for informational coverage (its `coverage`
# CI step is continue-on-error and not a required gate), so ignoring the
# stale peer range is the minimal, intentional choice. Mirrors the frontend
# and backend repos, which both set legacy-peer-deps=true.
legacy-peer-deps=true
