# Base network RPCs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Private key used for deployments and contract operations
PRIVATE_KEY=your_private_key_here

# Unified Etherscan / Basescan API key used by Hardhat verification
BASESCAN_API_KEY=your_basescan_api_key

# ── Core Protocol Addresses & Accounts ─────────────────────────────────────────
PLATFORM_TREASURY_ADDRESS=0x...
DAO_MULTISIG_ADDRESS=0x...
USDC_ADDRESS=0x...

# ── Deployed Contract Addresses (populated post-deployment) ───────────────────
ATTR_TOKEN_ADDRESS=
MEMBERSHIP_TOKEN_CONTRACT=
ATTR_ONBOARDING_VAULT_ADDRESS=
ATTR_SPENDER_CONTRACT=
FACTORY_CONTRACT_ADDRESS=
VESTING_LOCK_CAMPAIGN_FACTORY_ADDRESS=
MEMBERSHIP_FEE_DISTRIBUTOR_ADDRESS=

# ── Membership Configuration ──────────────────────────────────────────────────
MEMBERSHIP_NAME="ATTR-MEMBER-ID"
MEMBERSHIP_SYMBOL="ATTR#"
MEMBERSHIP_MAX_SUPPLY=50000
MEMBERSHIP_MAX_MINT_PER_WALLET=2
MEMBERSHIP_ROYALTY_BPS=500
MEMBERSHIP_CONTRACT_URI="ipfs://QmAttributesMembershipURI"
MEMBERSHIP_PAYMENT_RECEIVER=
MEMBERSHIP_ROYALTY_RECEIVER=
